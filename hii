-- ================== HOLE GIVE ME HOOK ==================
local holeGiveMeBusy = false
local holeGiveMeHookInstalled = false

local function tryHookHoleGiveMe()
    if holeGiveMeHookInstalled then return end
    local rs = game:GetService("ReplicatedStorage")
    local remotes = rs:FindFirstChild("Remotes")
    local event = remotes and remotes:FindFirstChild("HoleGiveMe")
    if not event then return end

    local HOLD_TIME = 2

    local function markBusy()
        holeGiveMeBusy = true
        task.delay(HOLD_TIME, function()
            holeGiveMeBusy = false
        end)
    end

    if hookfunction and newcclosure then
        local ok = pcall(function()
            local oldInvoke = event.InvokeServer
            event.InvokeServer = newcclosure(function(self, ...)
                markBusy()
                return oldInvoke(self, ...)
            end)
        end)
        if ok then
            holeGiveMeHookInstalled = true
            print("[ItemHighlight] HoleGiveMe hook установлен (hookfunction)")
            return
        end
    end

    if hookmetamethod and getnamecallmethod and newcclosure then
        local ok = pcall(function()
            local mt = getrawmetatable(game)
            local oldNamecall = mt.__namecall
            setreadonly(mt, false)
            mt.__namecall = newcclosure(function(self, ...)
                local method = getnamecallmethod()
                if method == "InvokeServer" and self == event then
                    markBusy()
                end
                return oldNamecall(self, ...)
            end)
            setreadonly(mt, true)
        end)
        if ok then
            holeGiveMeHookInstalled = true
            print("[ItemHighlight] HoleGiveMe hook установлен (hookmetamethod)")
        end
    end
end

task.spawn(function()
    for _ = 1, 30 do
        tryHookHoleGiveMe()
        if holeGiveMeHookInstalled then break end
        task.wait(1)
    end
end)

-- ================== GODMODE ==================
local remotesFolder = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
local setBoarded = remotesFolder and remotesFolder:FindFirstChild("SetBoarded")

_G.godmodeActive = false

local function fireGodmode()
    if not setBoarded then return end
    pcall(function()
        setBoarded:FireServer(true, nil, GODMODE_CFRAME)
    end)
end

local function godmodeLoop()
    while _G.godmodeActive do
        fireGodmode()
        task.wait(0.15)
    end
end

local function setGodmodeActive(state)
    config.godmode = state
    saveConfig(config)
    _G.godmodeActive = state
    if state then task.spawn(godmodeLoop) end
end

if setBoarded and hookmetamethod and getnamecallmethod and newcclosure then
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" and self == setBoarded then
            local args = {...}
            if args[1] == false and _G.godmodeActive then
                task.spawn(fireGodmode)
            end
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end

-- ================== SPEEDHACK ==================
local speedHackConn = nil
local savedWalkSpeed = nil

local function getHumanoid()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function stopSpeedHackLoop()
    if speedHackConn then
        speedHackConn:Disconnect()
        speedHackConn = nil
    end
end

local function setSpeedHack(state, mode)
    mode = mode or "user"
    config.speedHack = state
    saveConfig(config)

    local hum = getHumanoid()

    if state then
        if hum then
            savedWalkSpeed = hum.WalkSpeed
            hum.WalkSpeed = SPEEDHACK_VALUE
        end

        stopSpeedHackLoop()
        speedHackConn = RunService.Heartbeat:Connect(function()
            if not config.speedHack then return end
            local h = getHumanoid()
            if not h then return end

            if holeGiveMeBusy then
                if h.WalkSpeed ~= SPEEDHACK_VALUE then
                    h.WalkSpeed = SPEEDHACK_VALUE
                end
                return
            end

            if h.WalkSpeed ~= SPEEDHACK_VALUE then
                setSpeedHack(false, "auto")
            end
        end)

        if mode == "user" and pushNotification then
            pushNotification(
                "SpeedHack: ВКЛ (" .. SPEEDHACK_VALUE ..
                "), было: " .. tostring(savedWalkSpeed or "?"),
                Color3.fromRGB(255, 200, 60)
            )
        end
    else
        if mode == "user" and hum and savedWalkSpeed then
            hum.WalkSpeed = savedWalkSpeed
        end
        savedWalkSpeed = nil
        stopSpeedHackLoop()
        if mode == "user" and pushNotification then
            pushNotification("SpeedHack: ВЫКЛ", Color3.fromRGB(180, 180, 180))
        end
    end
end

