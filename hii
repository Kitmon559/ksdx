            nc.Parent = nameBtn
            local pad = Instance.new("UIPadding")
            pad.PaddingLeft = UDim.new(0, 8)
            pad.Parent = nameBtn

            local tpBtn = Instance.new("TextButton")
            tpBtn.Size = UDim2.new(0, 42, 1, 0)
            tpBtn.Position = UDim2.new(1, -110, 0, 0)
            tpBtn.BackgroundColor3 = Color3.fromRGB(180, 120, 40)
            tpBtn.BorderSizePixel = 0
            tpBtn.Text = "ТП"
            tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            tpBtn.Font = Enum.Font.GothamBold
            tpBtn.TextSize = 12
            tpBtn.Parent = rowFrame
            local tpc = Instance.new("UICorner")
            tpc.CornerRadius = UDim.new(0, 5)
            tpc.Parent = tpBtn

            local colorBtn = Instance.new("TextButton")
            colorBtn.Size = UDim2.new(0, 42, 1, 0)
            colorBtn.Position = UDim2.new(1, -66, 0, 0)
            colorBtn.BackgroundColor3 = Color3.fromRGB(90, 90, 140)
            colorBtn.BorderSizePixel = 0
            colorBtn.Text = "ЦВЕТ"
            colorBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            colorBtn.Font = Enum.Font.GothamBold
            colorBtn.TextSize = 10
            colorBtn.Parent = rowFrame
            local cbc = Instance.new("UICorner")
            cbc.CornerRadius = UDim.new(0, 5)
            cbc.Parent = colorBtn

            local resetBtn = Instance.new("TextButton")
            resetBtn.Size = UDim2.new(0, 22, 1, 0)
            resetBtn.Position = UDim2.new(1, -22, 0, 0)
            resetBtn.BackgroundColor3 = Color3.fromRGB(90, 60, 60)
            resetBtn.BorderSizePixel = 0
            resetBtn.Text = "✕"
            resetBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            resetBtn.Font = Enum.Font.GothamBold
            resetBtn.TextSize = 12
            resetBtn.Visible = hasPerItemColor(name)
            resetBtn.Parent = rowFrame
            local rbc = Instance.new("UICorner")
            rbc.CornerRadius = UDim.new(0, 5)
            rbc.Parent = resetBtn

            if count == 0 then
                nameBtn.BackgroundColor3 = sel and Color3.fromRGB(50, 70, 110) or Color3.fromRGB(30, 30, 38)
                nameBtn.TextColor3 = sel and Color3.fromRGB(200, 200, 210) or Color3.fromRGB(150, 150, 160)
                tpBtn.Visible = false
            else
                nameBtn.BackgroundColor3 = sel and Color3.fromRGB(70, 120, 200) or Color3.fromRGB(40, 40, 50)
                nameBtn.TextColor3 = sel and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(230, 230, 240)
                tpBtn.Visible = true
            end

            local rarity = ITEM_RARITY[normalize(name)]
            local rarityTag = rarity and ("[" .. rarity .. "] ") or ""
            local starTag = hasPerItemColor(name) and "★ " or ""
            nameBtn.Text = starTag .. rarityTag .. name .. "  (x" .. count .. ")"

            nameBtn.MouseButton1Click:Connect(function()
                if isSelected(name) then removeSelected(name) else addSelected(name) end
                buildList()
                updateAllVisuals()
            end)

            tpBtn.MouseButton1Click:Connect(function()
                task.spawn(tweenTeleportAndPickup, name)
            end)

            colorBtn.MouseButton1Click:Connect(function()
                openColorPicker(name)
            end)

            resetBtn.MouseButton1Click:Connect(function()
                clearPerItemColor(name)
                updateAllVisuals()
                buildList()
            end)

            itemRows[normalize(name)] = {
                nameBtn = nameBtn,
                tpBtn = tpBtn,
                colorBtn = colorBtn,
                resetBtn = resetBtn,
                colorMark = colorMark,
                rowFrame = rowFrame,
            }
        end
    end
end

