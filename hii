            speedKeyBtn.BackgroundColor3 = Color3.fromRGB(60, 90, 140)
            listeningFor = nil
            return
        end

        local keyName = keyFromInput(input)
        if keyName then
            if listeningFor == "menu" then
                config.menuKey = keyName
                saveConfig(config)
                if pushNotification then
                    pushNotification("Бинд меню: " .. keyName, Color3.fromRGB(120, 180, 255))
                end
            elseif listeningFor == "speed" then
                config.speedKey = keyName
                saveConfig(config)
                if pushNotification then
                    pushNotification("Бинд SpeedHack: " .. keyName, Color3.fromRGB(255, 200, 60))
                end
            end
            applyBindLabels()
            menuKeyBtn.BackgroundColor3 = Color3.fromRGB(60, 90, 140)
            speedKeyBtn.BackgroundColor3 = Color3.fromRGB(60, 90, 140)
            listeningFor = nil
        end
        return
    end

    if gp then return end

    local keyName = keyFromInput(input)
    if not keyName then return end

    if keyName == config.menuKey then
        main.Visible = not main.Visible
        if main.Visible and buildList then buildList() end
    elseif keyName == config.speedKey then
        setSpeedHack(not config.speedHack, "user")
    end
end)

