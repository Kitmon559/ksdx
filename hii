-- ================== ТП ==================
local function getItemPosition(item, fromPos)
    if not item or not item.Parent then return nil end
    if item:IsA("BasePart") then return item.Position, item end

    local parts = {}
    for _, d in ipairs(item:GetDescendants()) do
        if d:IsA("BasePart") and d.Transparency < 1 and d.Size.Magnitude > 0.1 then
            table.insert(parts, d)
        end
    end

    if #parts == 0 then
        if item.PrimaryPart then return item.PrimaryPart.Position, item.PrimaryPart end
        local ok, pivot = pcall(function() return item:GetPivot() end)
        if ok and pivot then return pivot.Position end
        return nil
    end

    if fromPos then
        local best, bestDist = nil, math.huge
        for _, p in ipairs(parts) do
            local d = (p.Position - fromPos).Magnitude
            if d < bestDist then
                bestDist = d
                best = p
            end
        end
        return best.Position, best
    end

    local sum = Vector3.zero
    for _, p in ipairs(parts) do sum += p.Position end
    return sum / #parts
end

local function isValidItem(item)
    if not item or not item.Parent then return false end
    if not item:IsDescendantOf(SpawnedItems) then return false end
    if not item:IsDescendantOf(workspace) then return false end

    local hasVisible = false
    if item:IsA("BasePart") then
        if item.Transparency < 1 and item.Size.Magnitude > 0.1 then hasVisible = true end
    else
        for _, d in ipairs(item:GetDescendants()) do
            if d:IsA("BasePart") and d.Transparency < 1 and d.Size.Magnitude > 0.1 then
                hasVisible = true
                break
            end
        end
    end
    if not hasVisible then return false end

    local pos = getItemPosition(item)
    if not pos then return false end
    if pos.Magnitude < 0.1 then return false end
    if pos.Y < -500 or pos.Y > 5000 then return false end
    return true
end

local function findRandomItemByName(name)
    local norm = normalize(name)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local origin = root and root.Position or Vector3.new(0, 0, 0)

    local nearList, farList = {}, {}

    for _, item in ipairs(collectItems()) do
        if normalize(item.Name) == norm and isValidItem(item) then
            local pos, part = getItemPosition(item, origin)
            if pos then
                local dist = (origin - pos).Magnitude
                local entry = { item = item, pos = pos, part = part }
                if dist <= MAX_NEAR_DISTANCE then
                    table.insert(nearList, entry)
                else
                    table.insert(farList, entry)
                end
            end
        end
    end

    if #nearList > 0 then
        local p = nearList[math.random(1, #nearList)]
        return p.item, p.pos, p.part
    end
    if #farList > 0 then
        local p = farList[math.random(1, #farList)]
        return p.item, p.pos, p.part
    end
    return nil
end

local function getCurrentSpeed()
