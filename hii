local itemRows = {}

local function getCountsByNorm()
    local counts = {}
    for _, item in ipairs(collectItems()) do
        local n = normalize(item.Name)
        counts[n] = (counts[n] or 0) + 1
    end
    return counts
end

buildList = function()
    for _, row in pairs(itemRows) do
        if row.rowFrame then row.rowFrame:Destroy() end
    end
    itemRows = {}

    local counts = getCountsByNorm()

    local allNames = {}
    local seen = {}
    local function addName(n)
        local norm = normalize(n)
        if norm ~= "" and not seen[norm] then
            seen[norm] = true
            table.insert(allNames, n)
        end
    end
    for _, n in ipairs(config.knownNames) do addName(n) end
    for _, item in ipairs(collectItems()) do addName(item.Name) end
    for _, n in ipairs(MANUAL_ITEMS) do addName(n) end

    local rarityRank = {}
    for i, r in ipairs(RARITY_ORDER) do rarityRank[r] = i end

    table.sort(allNames, function(a, b)
        local ra = ITEM_RARITY[normalize(a)]
        local rb = ITEM_RARITY[normalize(b)]
        local oa = 999
        local ob = 999
        if ra then oa = rarityRank[ra] or 999 end
        if rb then ob = rarityRank[rb] or 999 end
        if oa ~= ob then return oa < ob end
        return a:lower() < b:lower()
    end)

    local filter = searchBox.Text:lower()

    for _, name in ipairs(allNames) do
        if filter == "" or name:lower():find(filter, 1, true) then
            local count = counts[normalize(name)] or 0
            local sel = isSelected(name)

            local rowFrame = Instance.new("Frame")
            rowFrame.Size = UDim2.new(1, 0, 0, 24)
            rowFrame.BackgroundTransparency = 1
            rowFrame.Parent = scroll

            local colorMark = Instance.new("Frame")
            colorMark.Size = UDim2.new(0, 5, 1, -6)
            colorMark.Position = UDim2.new(0, 0, 0, 3)
            colorMark.BackgroundColor3 = getColorForName(name)
            colorMark.BorderSizePixel = 0
            colorMark.Parent = rowFrame
            local cmc = Instance.new("UICorner")
            cmc.CornerRadius = UDim.new(0, 3)
            cmc.Parent = colorMark

            local nameBtn = Instance.new("TextButton")
            nameBtn.Size = UDim2.new(1, -120, 1, 0)
            nameBtn.Position = UDim2.new(0, 8, 0, 0)
            nameBtn.BorderSizePixel = 0
            nameBtn.Font = Enum.Font.Gotham
            nameBtn.TextSize = 12
            nameBtn.TextXAlignment = Enum.TextXAlignment.Left
            nameBtn.Parent = rowFrame
            local nc = Instance.new("UICorner")
            nc.CornerRadius = UDim.new(0, 5)
            nc.Parent = nameBtn
            local pad = Instance.new("UIPadding")
            pad.PaddingLeft = UDim.new(0, 8)
            pad.Parent = nameBtn

            local tpBtn = Instance.new("TextButton")
            tpBtn.Size = UDim2.new(0, 42, 1, 0)
            tpBtn.Position = UDim2.new(1, -110, 0, 0)
            tpBtn.BackgroundColor3 = Color3.fromRGB(180, 120, 40)
            tpBtn.BorderSizePixel = 0
            tpBtn.Text = "ТП"
            tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            tpBtn.Font = Enum.Font.GothamBold
            tpBtn.TextSize = 12
            tpBtn.Parent = rowFrame
            local tpc = Instance.new("UICorner")
            tpc.CornerRadius = UDim.new(0, 5)
            tpc.Parent = tpBtn

            local colorBtn = Instance.new("TextButton")
            colorBtn.Size = UDim2.new(0, 42, 1, 0)
            colorBtn.Position = UDim2.new(1, -66, 0, 0)
            colorBtn.BackgroundColor3 = Color3.fromRGB(90, 90, 140)
            colorBtn.BorderSizePixel = 0
            colorBtn.Text = "ЦВЕТ"
            colorBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            colorBtn.Font = Enum.Font.GothamBold
            colorBtn.TextSize = 10
            colorBtn.Parent = rowFrame
            local cbc = Instance.new("UICorner")
            cbc.CornerRadius = UDim.new(0, 5)
            cbc.Parent = colorBtn

            local resetBtn = Instance.new("TextButton")
            resetBtn.Size = UDim2.new(0, 22, 1, 0)
            resetBtn.Position = UDim2.new(1, -22, 0, 0)
            resetBtn.BackgroundColor3 = Color3.fromRGB(90, 60, 60)
            resetBtn.BorderSizePixel = 0
            resetBtn.Text = "✕"
            resetBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            resetBtn.Font = Enum.Font.GothamBold
            resetBtn.TextSize = 12
            resetBtn.Visible = hasPerItemColor(name)
            resetBtn.Parent = rowFrame
            local rbc = Instance.new("UICorner")
            rbc.CornerRadius = UDim.new(0, 5)
            rbc.Parent = resetBtn

            if count == 0 then
                nameBtn.BackgroundColor3 = sel and Color3.fromRGB(50, 70, 110) or Color3.fromRGB(30, 30, 38)
                nameBtn.TextColor3 = sel and Color3.fromRGB(200, 200, 210) or Color3.fromRGB(150, 150, 160)
                tpBtn.Visible = false
            else
                nameBtn.BackgroundColor3 = sel and Color3.fromRGB(70, 120, 200) or Color3.fromRGB(40, 40, 50)
                nameBtn.TextColor3 = sel and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(230, 230, 240)
                tpBtn.Visible = true
            end

            local rarity = ITEM_RARITY[normalize(name)]
            local rarityTag = ""
            if rarity then rarityTag = "[" .. rarity .. "] " end
            local starTag = ""
            if hasPerItemColor(name) then starTag = "★ " end
            nameBtn.Text = starTag .. rarityTag .. name .. "  (x" .. count .. ")"

            nameBtn.MouseButton1Click:Connect(function()
                if isSelected(name) then
                    removeSelected(name)
                else
                    addSelected(name)
                end
                buildList()
                updateAllVisuals()
            end)

            tpBtn.MouseButton1Click:Connect(function()
                task.spawn(tweenTeleportAndPickup, name)
            end)

            colorBtn.MouseButton1Click:Connect(function()
                openColorPicker(name)
            end)

            resetBtn.MouseButton1Click:Connect(function()
                clearPerItemColor(name)
                updateAllVisuals()
                buildList()
            end)

            itemRows[normalize(name)] = {
                nameBtn = nameBtn,
                tpBtn = tpBtn,
                colorBtn = colorBtn,
                resetBtn = resetBtn,
                colorMark = colorMark,
                rowFrame = rowFrame,
            }
        end
    end
end

