local selectedByNorm = {}
local knownNamesSet = {}

local function rebuildSelectedNormalized()
    selectedByNorm = {}
    for _, name in ipairs(config.selected) do
        selectedByNorm[normalize(name)] = name
    end
end

local function rebuildKnownNamesSet()
    knownNamesSet = {}
    for _, name in ipairs(config.knownNames) do
        knownNamesSet[normalize(name)] = name
    end
end

rebuildSelectedNormalized()
rebuildKnownNamesSet()

local function rememberName(name)
    local norm = normalize(name)
    if norm == "" then return end
    if not knownNamesSet[norm] then
        knownNamesSet[norm] = name
        table.insert(config.knownNames, name)
        saveConfig(config)
    end
end

local function getSelectedOriginal(name) return selectedByNorm[normalize(name)] end
local function isSelected(name) return getSelectedOriginal(name) ~= nil end

local function addSelected(name)
    local norm = normalize(name)
    if norm == "" then return end
    if not selectedByNorm[norm] then
        selectedByNorm[norm] = name
        table.insert(config.selected, name)
        saveConfig(config)
    end
end

local function removeSelected(name)
    local norm = normalize(name)
    if selectedByNorm[norm] then
        selectedByNorm[norm] = nil
        for i, n in ipairs(config.selected) do
            if normalize(n) == norm then
                table.remove(config.selected, i)
                break
            end
        end
        saveConfig(config)
    end
end

local function getColorForName(name)
    local norm = normalize(name)
    local pc = config.perItemColors[norm]
    if pc then return Color3.new(pc.r, pc.g, pc.b) end
    local rc = getRarityColor(name)
    if rc then return rc end
    return Color3.new(config.color.r, config.color.g, config.color.b)
end

local function setPerItemColor(name, r, g, b)
    config.perItemColors[normalize(name)] = { r = r, g = g, b = b }
    saveConfig(config)
end

local function clearPerItemColor(name)
    config.perItemColors[normalize(name)] = nil
    saveConfig(config)
end

local function hasPerItemColor(name)
    return config.perItemColors[normalize(name)] ~= nil
end

