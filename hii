        local s = tonumber(config.customSpeed)
        if s and s >= 0 then return s end
    end
    return TP_SPEEDS[config.tpSpeed] or TP_SPEEDS["Быстро"]
end

local tweenTpRunning = false

local function tweenTeleportAndPickup(name)
    if tweenTpRunning then
        if pushNotification then pushNotification("ТП уже идёт", Color3.fromRGB(200, 200, 80)) end
        return
    end

    local char = player.Character
    if not char then
        if pushNotification then pushNotification("Нет персонажа", Color3.fromRGB(200, 100, 100)) end
        return
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then
        if pushNotification then pushNotification("Нет HumanoidRootPart", Color3.fromRGB(200, 100, 100)) end
        return
    end

    tweenTpRunning = true

    local item, itemPos, targetPart
    for _ = 1, 5 do
        item, itemPos, targetPart = findRandomItemByName(name)
        if item and itemPos then break end
        item, itemPos, targetPart = nil, nil, nil
        task.wait(0.1)
    end

    if not item or not itemPos then
        tweenTpRunning = false
        if pushNotification then pushNotification(name .. ": нет в мире", Color3.fromRGB(200, 100, 100)) end
        return
    end

    local startPos = root.Position
    local focusPos = targetPart and targetPart.Position or itemPos

    local offsetDir = startPos - focusPos
    offsetDir = Vector3.new(offsetDir.X, 0, offsetDir.Z)
    if offsetDir.Magnitude < 0.5 then
        offsetDir = Vector3.new(math.random(-3, 3), 0, math.random(-3, 3))
        if offsetDir.Magnitude < 0.5 then offsetDir = Vector3.new(3, 0, 3) end
    end
    offsetDir = offsetDir.Unit

    local partSize = targetPart and targetPart.Size or Vector3.new(4, 4, 4)
    local radius = math.max(partSize.X, partSize.Z) * 0.5 + TP_OFFSET

    local targetPos = focusPos + offsetDir * radius

    local ray = Ray.new(targetPos + Vector3.new(0, 20, 0), Vector3.new(0, -200, 0))
    local hitPart = workspace:FindPartOnRay(ray, char)
    if hitPart then
        targetPos = hitPart.Position + Vector3.new(0, 3.5, 0)
    end

    local lookDir = focusPos - targetPos
    lookDir = Vector3.new(lookDir.X, 0, lookDir.Z)
    if lookDir.Magnitude < 0.1 then lookDir = Vector3.new(0, 0, -1) end
    local targetCF = CFrame.new(targetPos, targetPos + lookDir.Unit)

    local flyTime = getCurrentSpeed()

    if flyTime <= 0.01 then
        root.CFrame = targetCF
    else
        local tweenTo = TweenService:Create(
            root,
            TweenInfo.new(flyTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { CFrame = targetCF }
        )
        tweenTo:Play()
        tweenTo.Completed:Wait()
    end

    task.wait(TP_WAIT_LAND)
    if isValidItem(item) then grabItem(item) end
    task.wait(TP_WAIT_PICKUP)

    root.Velocity = Vector3.zero
    root.RotVelocity = Vector3.zero

    tweenTpRunning = false
    if pushNotification then
        pushNotification("ТП: " .. name .. " — готово", Color3.fromRGB(80, 180, 255))
    end
end

