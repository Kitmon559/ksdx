end

local function grabItem(item)
    local holdTime = 0.4
    if item then
        local pp = item:FindFirstChildWhichIsA("ProximityPrompt", true)
        if pp and pp.HoldDuration and pp.HoldDuration > 0 then
            holdTime = pp.HoldDuration + 0.15
        end
    end
    doE()
    task.wait(0.08)
    holdE(holdTime)
    task.wait(0.08)
    for _ = 1, TP_E_COUNT do
        doE()
        task.wait(TP_E_DELAY)
    end
end

-- ================== ТП ==================
local function getItemPosition(item)
    if not item then return nil end
    if not item.Parent then return nil end

    if item:IsA("BasePart") then
        return item.Position
    end

    if item:IsA("Model") then
        local success, pivot = pcall(function()
            return item:GetPivot()
        end)
        if success then
            return pivot.Position
        end
    end

    return nil
end

local function isValidItem(item)
    if not item then return false end
    if not item.Parent then return false end
    if not item:IsDescendantOf(SpawnedItems) then return false end
    if not item:IsDescendantOf(workspace) then return false end

    local isBasePart = item:IsA("BasePart")
    local isModel = item:IsA("Model")
    if not isBasePart and not isModel then return false end

    local pos = getItemPosition(item)
    if not pos then return false end

    return true
end

local function findRandomItemByName(name)
    local norm = normalize(name)
    local list = {}

    local items = collectItems()
    for _, item in ipairs(items) do
        if normalize(item.Name) == norm then
            if isValidItem(item) then
                table.insert(list, item)
            end
        end
    end

    if #list == 0 then return nil end
    return list[math.random(1, #list)]
end

local function getCurrentSpeed()
    if config.useCustomSpeed then
        local s = tonumber(config.customSpeed)
        if s and s >= 0 then return s end
    end
    return TP_SPEEDS[config.tpSpeed] or TP_SPEEDS["Очень быстро"]
end

local tweenTpRunning = false

local function tweenTeleportAndPickup(name)
    if tweenTpRunning then
        if pushNotification then
            pushNotification("ТП уже идёт", Color3.fromRGB(200, 200, 80))
        end
        return
    end

    local char = player.Character
    if not char then
        if pushNotification then pushNotification("Нет персонажа", Color3.fromRGB(200, 100, 100)) end
        return
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then
        if pushNotification then pushNotification("Нет HumanoidRootPart", Color3.fromRGB(200, 100, 100)) end
        return
    end

    tweenTpRunning = true

    local item
    for _ = 1, 5 do
        item = findRandomItemByName(name)
        if item and isValidItem(item) then break end
        item = nil
        task.wait(0.1)
    end

    if not item then
        tweenTpRunning = false
        if pushNotification then
            pushNotification(name .. ": нет в мире", Color3.fromRGB(200, 100, 100))
        end
        return
    end

    local pos = getItemPosition(item)
    if not pos then
        tweenTpRunning = false
        if pushNotification then
            pushNotification(name .. ": нет позиции", Color3.fromRGB(200, 100, 100))
        end
        return
    end

    local startPos = root.Position
    local distance = (startPos - pos).Magnitude
    local speed = getCurrentSpeed()

    if speed <= 0.01 then
        root.CFrame = CFrame.new(pos)
    else
        local flyTime = distance / speed
        if flyTime < 0.05 then flyTime = 0.05 end
        local tweenTo = TweenService:Create(
            root,
            TweenInfo.new(flyTime, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
            { CFrame = CFrame.new(pos) }
        )
        tweenTo:Play()
        tweenTo.Completed:Wait()
    end

    task.wait(TP_WAIT_LAND)
    if isValidItem(item) then grabItem(item) end
    task.wait(TP_WAIT_PICKUP)

    root.Velocity = Vector3.zero
    root.RotVelocity = Vector3.zero

    tweenTpRunning = false
    if pushNotification then
        pushNotification("ТП: " .. name .. " — готово", Color3.fromRGB(80, 180, 255))
    end
end

