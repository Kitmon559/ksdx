-- ================== ANTI-MOVE ==================
local RIVER_PATH = {"0Map", "RiverBay", "RiverSite", "Floors", "RiverWater"}
local antiMoveConn = nil
local antiPlatform = nil
local riverStartCF = nil

local function getRiverWater()
    local cur = workspace
    for _, name in ipairs(RIVER_PATH) do
        if not cur then return nil end
        cur = cur:FindFirstChild(name)
    end
    return cur
end

local function spawnAntiPlatform(rw)
    if antiPlatform and antiPlatform.Parent then antiPlatform:Destroy() end
    local rwSize, rwCF = rw.Size, rw.CFrame
    local plat = Instance.new("Part")
    plat.Name = "AntiMovePlatform"
    plat.Size = Vector3.new(rwSize.X * 1.05, 1, rwSize.Z * 1.05)
    plat.CFrame = CFrame.new((rwCF * CFrame.new(0, -(rwSize.Y / 2) - 0.5, 0)).Position)
    plat.Anchored = true
    plat.CanCollide = true
    plat.CanTouch = true
    plat.CanQuery = true
    plat.Transparency = 1
    plat.CastShadow = false
    plat.Material = Enum.Material.SmoothPlastic
    plat.Parent = workspace
    antiPlatform = plat
end

local function applyAntiMove(state)
    local rw = getRiverWater()
    if not rw or not rw:IsA("BasePart") then
        warn("[ItemHighlight] Anti-Move: RiverWater не найден")
        return
    end
    if state then
        riverStartCF = rw.CFrame
        spawnAntiPlatform(rw)
    else
        if antiPlatform then antiPlatform:Destroy(); antiPlatform = nil end
        riverStartCF = nil
    end
end

local function startAntiMoveLoop()
    if antiMoveConn then antiMoveConn:Disconnect() end
    antiMoveConn = RunService.Heartbeat:Connect(function()
        if not config.antiMove then return end
        local rw = getRiverWater()
        if rw and rw:IsA("BasePart") then
            if riverStartCF and (rw.CFrame.Position - riverStartCF.Position).Magnitude > 0.5 then
                rw.CFrame = riverStartCF
            end
            pcall(function()
                rw.AssemblyLinearVelocity  = Vector3.zero
                rw.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end)
end

local function setAntiMove(state)
    config.antiMove = state
    saveConfig(config)
    applyAntiMove(state)
    if state then
        startAntiMoveLoop()
        if pushNotification then
            pushNotification("Anti-Move: ВКЛ", Color3.fromRGB(80, 200, 160))
        end
    else
        if antiMoveConn then antiMoveConn:Disconnect(); antiMoveConn = nil end
        if pushNotification then
            pushNotification("Anti-Move: ВЫКЛ", Color3.fromRGB(200, 120, 80))
        end
    end
end

