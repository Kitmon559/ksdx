local activeVisuals = {}

local function removeVisualsForItem(item)
    local data = activeVisuals[item]
    if data then
        if data.highlight then data.highlight:Destroy() end
        if data.box then data.box:Destroy() end
        if data.esp then data.esp:Destroy() end
    end
    activeVisuals[item] = nil
end

local function buildESP(item, displayName, c)
    local old = item:FindFirstChild("ItemESP")
    if old then old:Destroy() end

    local s = ESP_SIZES[config.espSize] or ESP_SIZES["Средний"]

    local esp = Instance.new("BillboardGui")
    esp.Name = "ItemESP"
    esp.Adornee = item
    esp.Size = UDim2.new(0, s.width, 0, s.nameSize + s.distSize + 10)
    esp.StudsOffset = Vector3.new(0, s.height / 6, 0)
    esp.AlwaysOnTop = true
    esp.MaxDistance = 2000
    esp.Parent = item

    if config.showNames then
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Name = "NameLabel"
        nameLabel.Size = UDim2.new(1, 0, 0, s.nameSize + 6)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = displayName or item.Name
        nameLabel.TextColor3 = c
        nameLabel.TextStrokeTransparency = 0
        nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextSize = s.nameSize
        nameLabel.Parent = esp

        local distLabel = Instance.new("TextLabel")
        distLabel.Name = "DistLabel"
        distLabel.Size = UDim2.new(1, 0, 0, s.distSize + 4)
        distLabel.Position = UDim2.new(0, 0, 0, s.nameSize + 6)
        distLabel.BackgroundTransparency = 1
        distLabel.Text = "0 studs"
        distLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        distLabel.TextStrokeTransparency = 0
        distLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        distLabel.Font = Enum.Font.GothamBold
        distLabel.TextSize = s.distSize
        distLabel.Parent = esp
    end

    return esp
end

local function applyVisualsToItem(item, displayName)
    local c = getColorForName(displayName or item.Name)

    if activeVisuals[item] then
        local d = activeVisuals[item]
        if d.highlight then d.highlight.FillColor = c end
        if d.box then d.box.Color3 = c end
        if d.esp then
            local nl = d.esp:FindFirstChild("NameLabel")
            if nl then nl.TextColor3 = c end
        end
        return
    end

    local hl = Instance.new("Highlight")
    hl.Name = "ItemHighlight"
    hl.Adornee = item
    hl.FillColor = c
    hl.OutlineColor = Color3.new(1, 1, 1)
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = item

    local box = nil
    if item:IsA("Model") then
        box = Instance.new("SelectionBox")
        box.Name = "ItemHighlightBox"
        box.Adornee = item
        box.Color3 = c
        box.LineThickness = 0.05
        box.SurfaceTransparency = 1
        box.Parent = item
    end

    local esp = nil
    if config.esp then
        esp = buildESP(item, displayName or item.Name, c)
    end

    activeVisuals[item] = { highlight = hl, name = displayName, box = box, esp = esp }

    item.AncestryChanged:Connect(function(_, parent)
        if not parent then removeVisualsForItem(item) end
    end)
end

local function clearAllVisuals()
    for item in pairs(activeVisuals) do
        removeVisualsForItem(item)
    end
    activeVisuals = {}
end

-- ============ СБОР ПРЕДМЕТОВ ============
local function collectItems()
    local list = {}
    local function addFrom(parent)
        local ok, kids = pcall(function() return parent:GetChildren() end)
        if not ok or not kids then return end
        for _, c in ipairs(kids) do
            if c:IsA("Folder") then
                addFrom(c)
            elseif c:IsA("Model") or c:IsA("Tool") or c:IsA("Accessory") or c:IsA("BasePart") then
                table.insert(list, c)
            end
        end
    end
    addFrom(SpawnedItems)
    return list
end

local function updateAllVisuals()
    if not config.enabled then
        clearAllVisuals()
        return
    end

    for item, data in pairs(activeVisuals) do
        if not isSelected(data.name) then
            removeVisualsForItem(item)
        end
    end

    for _, item in ipairs(collectItems()) do
        local orig = getSelectedOriginal(item.Name)
        if orig then
            applyVisualsToItem(item, orig)
        end
    end

    for _, data in pairs(activeVisuals) do
        local c = getColorForName(data.name)
        if data.highlight then data.highlight.FillColor = c end
        if data.box then data.box.Color3 = c end
        if data.esp then
            local nl = data.esp:FindFirstChild("NameLabel")
            if nl then nl.TextColor3 = c end
        end
    end
end

local function rebuildAllESP()
    for item, data in pairs(activeVisuals) do
        if config.esp then
            local c = getColorForName(data.name)
            data.esp = buildESP(item, data.name, c)
        else
            if data.esp then
                data.esp:Destroy()
                data.esp = nil
            end
        end
    end
end

